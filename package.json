{
  "name": "quina-webapp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:oracle": "python3 -I scripts/finance-oracle.py --check",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:roles": "node --env-file-if-exists=.env.local scripts/db-roles.ts",
    "db:admin": "node --env-file-if-exists=.env.local scripts/create-platform-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@marsidev/react-turnstile": "^1.6.2",
    "@node-rs/argon2": "^2.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "better-auth": "^1.7.11",
    "boneyard-js": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.59.0",
    "mercadopago": "^3.6.1",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sileo": "^0.1.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
