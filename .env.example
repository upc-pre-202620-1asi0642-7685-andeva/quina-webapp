# Copia este archivo a .env.local y completa los valores.
# Detalle de cada variable: docs/quina-webapp-documentation.md, sección 9.

# URL pública de la webapp (en local: http://localhost:3000/app)
APP_URL=http://localhost:3000/app

# Base de datos: la app se conecta como quina_app por Supavisor (puerto 6543)
DATABASE_URL=
# Solo Drizzle Kit: conexión directa con el rol postgres (puerto 5432)
DATABASE_MIGRATION_URL=

# Contraseñas de los roles quina_app y quina_platform (las aplica `pnpm db:roles`)
QUINA_APP_DB_PASSWORD=
QUINA_PLATFORM_DB_PASSWORD=

# Pruebas de integración (`pnpm test:db`): propietario (migra y limpia) y quina_app (prueba RLS)
DATABASE_TEST_URL=
DATABASE_TEST_APP_URL=

# Correo: resend (envía de verdad) u outbox (guarda en la base, para desarrollo y pruebas)
EMAIL_TRANSPORT=outbox
EMAIL_FROM=Quina <hola@andeva.tech>

# Better Auth
BETTER_AUTH_SECRET=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Groq
GROQ_API_KEY=

# Supabase Storage (solo desde el servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proceso programado diario
CRON_SECRET=
