# Copia este archivo a .env.local y completa los valores.
# Detalle de cada variable: docs/quina-webapp-documentation.md, sección 9.

# URL pública de la webapp (en local: http://localhost:3000/app)
APP_URL=http://localhost:3000/app

# Base de datos. Los valores de abajo son del PostgreSQL local de Docker
# (`docker compose up -d`, puerto 54329, base quina_dev). En Supabase:
# DATABASE_URL es quina_app por Supavisor (puerto 6543) y DATABASE_MIGRATION_URL
# es la conexión directa con el rol postgres (puerto 5432).
# La app se conecta como quina_app (nunca salta RLS)
DATABASE_URL=postgres://quina_app:quina_app_test@localhost:54329/quina_dev
# Solo migraciones y `pnpm db:roles`: rol migrator en local, postgres en Supabase
DATABASE_MIGRATION_URL=postgres://migrator:migrator@localhost:54329/quina_dev
# Solo para escribir los topes del BCRP desde el panel de plataforma (rol quina_platform)
DATABASE_PLATFORM_URL=postgres://quina_platform:quina_platform_test@localhost:54329/quina_dev

# Contraseñas de los roles quina_app y quina_platform (las aplica `pnpm db:roles`).
# Los roles son de todo el servidor: en Docker, quina_dev y quina_test comparten
# contraseña, y `pnpm test:db` la fija en estos valores de prueba.
QUINA_APP_DB_PASSWORD=quina_app_test
QUINA_PLATFORM_DB_PASSWORD=quina_platform_test

# Pruebas de integración (`pnpm test:db`): PostgreSQL local de Docker, base quina_test.
# Propietario (migra y borra el esquema en cada corrida) y quina_app (prueba RLS).
# Nunca apuntes DATABASE_TEST_URL a una base con datos reales.
DATABASE_TEST_URL=postgres://migrator:migrator@localhost:54329/quina_test
DATABASE_TEST_APP_URL=postgres://quina_app:quina_app_test@localhost:54329/quina_test
DATABASE_TEST_PLATFORM_URL=postgres://quina_platform:quina_platform_test@localhost:54329/quina_test

# Primer Administrador de Plataforma: `pnpm db:admin` muestra su enlace para la contraseña
ADMIN_EMAIL=
ADMIN_NAME=

# Correo: resend (envía de verdad) u outbox (guarda en la base, para desarrollo y pruebas)
EMAIL_TRANSPORT=outbox
EMAIL_FROM=Quina <hola@andeva.tech>

# Better Auth
BETTER_AUTH_SECRET=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Mercado Pago: mercadopago (SDK oficial) o local (pasarela simulada en desarrollo y pruebas)
MP_TRANSPORT=local
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Groq
GROQ_API_KEY=

# Supabase Storage (solo desde el servidor). Imágenes del catálogo en el bucket
# público product-images: supabase (producción) o local (public/uploads, desarrollo y e2e)
STORAGE_TRANSPORT=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proceso programado diario
CRON_SECRET=
# Solo fuera de producción: 1 deja simular la fecha del cron con la cabecera x-quina-now
ALLOW_SIMULATED_NOW=
